{
  "name": "backend",
  "description": "Backend for Factory Planner with authentication and data sync",
  "author": "Matt Cavanagh",
  "main": "dist/main.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build": "pnpm --filter common run build && nest build",
    "typecheck": "pnpm --filter common run build && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "lint-check": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-ws": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.3",
    "bcryptjs": "^3.0.0",
    "common": "workspace:*",
    "mongoose": "^9.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "globals": "^17.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "catalog:",
    "supertest": "^7.2.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
