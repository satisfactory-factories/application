": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 42}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(prometheus_tsdb_compactions_failed_total[1h])", "legendFormat": "compactions failed"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(prometheus_tsdb_wal_corruptions_total[1h])", "legendFormat": "WAL corruptions"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(prometheus_tsdb_reloads_failures_total[1h])", "legendFormat": "block reload failures"}, {"refId": "D", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "1 - prometheus_config_last_reload_successful", "legendFormat": "config reload failed (1 = failed)"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}}, {"id": 24, "type": "timeseries", "title": "Query duration p90", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 42}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "prometheus_engine_query_duration_seconds{job=\"prometheus\",quantile=\"0.9\",slice=\"inner_eval\"}", "legendFormat": "inner_eval"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}}]}, "overwrite": true, "message": "Prometheus self-monitoring"}
